@'
# Unity generated files
Unity/Library/
Unity/Temp/
Unity/Obj/
Unity/obj/
Unity/Logs/
Unity/UserSettings/
Unity/.vs/
Unity/*_BurstDebugInformation_DoNotShip/

# Unity generated project files
Unity/*.csproj
Unity/*.sln
Unity/*.user
Unity/*.userprefs
Unity/*.pidb
Unity/*.booproj
Unity/*.svd
Unity/*.pdb
Unity/*.mdb
Unity/*.opendb
Unity/*.VC.db
Unity/*.vsidx
Unity/.vsconfig
Unity/ignore.conf

# Unity builds / exports
Unity/*.apk
Unity/*.aab
Unity/Build/
Unity/Builds/

# MATLAB / Simulink
*.asv
*.autosave
*.slxc
slprj/
codegen/
*_ert_rtw/
*_grt_rtw/
*.mex*
*.mexa64
*.mexw64
html/

# OS
.DS_Store
Thumbs.db
'@ | Set-Content -Encoding UTF8 .gitignore
# IDE folders anywhere
**/.idea/
**/.vscode/
**/.vs/

# Plastic SCM / Unity Version Control
**/.plastic/
